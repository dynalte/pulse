# Serveur MCP Pulse — copier en mcp/.env (ou laisser `npm run mcp:token` le créer).
# Ce fichier est ignoré par git.

# URL de l'API Pulse. Un domaine seul suffit : https://pulse.dynaspirit.com
PULSE_API_URL=https://pulse.dynaspirit.com/api-messagerie.php

# Jeton d'accès personnel — à générer dans Pulse : Réglages → Jetons d'accès (MCP / IA).
# Ou automatiquement avec : npm run mcp:token
PULSE_API_TOKEN=

# Alternative : jeton de session du navigateur (ancien mode).
# PULSE_SESSION_TOKEN=

# Alternative : identifiant + mot de passe (le serveur se connecte tout seul).
# PULSE_LOGIN=
# PULSE_PASSWORD=

# Sécurités (optionnel)
# PULSE_READ_ONLY=1   # n'expose que les outils de lecture
# PULSE_DRY_RUN=1     # simule les écritures sans les envoyer
# PULSE_TIMEOUT_MS=20000
# PULSE_MCP_CACHE_MS=3000   # cache court de conversations_list (0 = désactivé)
# PULSE_SESSION_FILE=~/.cache/pulse-mcp/session.json
